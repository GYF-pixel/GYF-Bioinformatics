##新版
colnames(dt) <- c("Gene_Set_Category","Gene_Set_ID","Gene_Set_Name","Gene_Set_Size","Count_Overlap_Gene",
"Percentage_Genes_in_Gene_Set","Fold_Enrichment","log2_fold","P_value","P_value_calc_log_10","Bonferroni",
"Benjamini_&_Hochberg","Benjamini_&_Yekutieli","Overlaping_Gene_Symbols","Overlapping_Gene_IDs")

colnames(dt)

#将Gene_Set_Name转换为因子，指定绘图顺序：

dt$Gene_Set_Name <- factor(dt$Gene_Set_Name, levels = rev(dt$Gene_Set_Name))

#基础富集条形图绘制：
p <- ggplot() +
  geom_bar(data = dt,
           aes(x = -log10(P_value), y = Gene_Set_Name, fill = Gene_Set_Category),
           width = 0.4, #柱子宽度调整
           stat = 'identity') +
  theme_classic()
p

#调整x轴原点与y轴相切：
p1 <- p + scale_x_continuous(expand = c(0,0))
p1

#将 terms标签叠加到柱子上：
p2 <- p1 +
  theme(axis.text.y = element_blank()) + #去掉y轴标签
  geom_text(data = dt,
            aes(x = 0.1, #用数值向量控制文本标签起始位置
                y = Gene_Set_Name,
                label = Gene_Set_Name),
            size = 4,
            hjust = 0) #左对齐
p2

#将Marker基因信息添加到terms标签信息下：
p3 <- p2 +
  geom_text(data = dt,
            aes(x = 0.1, y = Gene_Set_Name, label = Overlaping_Gene_Symbols, color = Gene_Set_Category),
            size = 4,
            fontface = 'italic', #geneID斜体
            hjust = 0,
            vjust = 2.3) #垂直偏移，调整文本向下
p3

#主标题和X/Y轴标题修改：
p4 <- p3 +
  labs(x = '-Log10(P value)',
       y = 'Enriched Signaling Pathway', #用空格控制间隙，多次调整直至合适
       title = 'Functional Annotation Enriched Terms')
p4

#KEGG Pathway D.mel Enriched Terms
#DRSC PathON Signaling Pathway (Core Components) Enriched Terms
#


#主题自定义：
##字体大小、粗细等细节调整；
mytheme <- theme(
  legend.position = 'none',
  plot.title = element_text(size = 12, face = 'bold'),
  axis.title = element_text(size = 10, face = 'bold'),
  axis.text = element_text(size = 10, face = 'bold'),
  axis.ticks.y = element_blank())

p5 <- p4 + mytheme
p5

#自定义配色：
#mycol <- c('#6fbedd', '#d9543d')
mycol <- c("#00468B","#EB4232")
p6 <- p5 +
  scale_fill_manual(values = mycol) +
  scale_color_manual(values = mycol)
p6

#Size 12 10 10
ggsave(filename = "01 Terms to  display Enriched Terms_DRSC  PathON target genes.pdf",plot = p5, width = 14,height = 12, units = "cm", dpi = 600)
#Size 12 10 10
ggsave(filename = "01 Terms to  display Enriched Terms_DRSC  PathON core components.pdf",plot = p6, width = 14,height = 12, units = "cm", dpi = 600)






